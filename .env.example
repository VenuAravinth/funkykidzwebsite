# Copy to .env.local (development) or set in your hosting provider's environment settings.
# Generate fresh secrets with:  npm run admin:secrets
# NEVER commit real values.

# --- Storefront ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://funkykidz.in
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Google Analytics 4 measurement ID (G-XXXXXXX). Tracks product views, add to cart, checkout and purchases.
NEXT_PUBLIC_GA_ID=
# UPI ID customers pay to at checkout (e.g. funkykidz@okaxis).
NEXT_PUBLIC_UPI_ID=

# --- Admin access ---------------------------------------------------------------
# Dedicated admin domain. When set, /admin only works on this host; the shop domain returns 404.
# Leave empty during local development.
ADMIN_HOST=admin.funkykidz.in
# Secret URL key. Open https://<ADMIN_HOST>/admin?key=<ADMIN_ACCESS_KEY> to reach the login page.
ADMIN_ACCESS_KEY=
# Signs the admin cookies (min 32 chars). Changing it signs everyone out.
ADMIN_SESSION_SECRET=
# Encrypts the Google Authenticator secret at rest (min 32 chars). Changing it requires re-enrolling.
ADMIN_ENCRYPTION_KEY=
# Session length in hours.
ADMIN_SESSION_HOURS=8

# Default login, used only until you change it from Admin → Account & security.
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
# Registered email that receives the login OTP.
ADMIN_EMAIL=

# --- Email (SMTP) for OTP -------------------------------------------------------
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FunkyKidz Admin <your-address@gmail.com>"

# --- Storage --------------------------------------------------------------------
# Only used once: if MongoDB has no admin record yet, data/admin.json (from before the database)
# is imported so the existing admin login keeps working. Everything else lives in MongoDB.
DATA_DIR=./data

# --- Database -------------------------------------------------------------------
# MongoDB connection string including the database name. Local default needs no credentials.
# Production example: mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/funkykidz
MONGODB_URI=mongodb://127.0.0.1:27017/funkykidz

# --- FunkyKidz ERP integration --------------------------------------------------------
# Products, categories and brands come from the ERP Backend's public API (product photos too).
ERP_API_URL=http://localhost:4000
# Shared secret the ERP backend sends to POST /api/revalidate after product changes.
REVALIDATE_SECRET=dummy-revalidate-secret-change-me-000000

# --- WhatsApp Cloud API (customer OTP) -----------------------------------------------
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
